# Copy to .env to override defaults (all optional)
LLM_PROVIDER=ollama          # ollama | gemini | openai
LLM_MODEL=llama3.2:3b        # e.g. gemini-2.5-flash or gpt-4o-mini
# GOOGLE_API_KEY=...         # if LLM_PROVIDER=gemini
# OPENAI_API_KEY=...         # if LLM_PROVIDER=openai
PG_DSN=postgresql://helpdesk_ro:readonly_dev_only@127.0.0.1:5433/helpdesk
MAX_DISTANCE=0.72
